{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "micfloat",
  "version": "0.1.0",
  "identifier": "com.alpha.micfloat",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "micfloat",
        "width": 800,
        "height": 600,
        "visible": false
      },
      {
        "label": "overlay",
        "title": "Overlay",
        "width": 500,
        "height": 400,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "center": true,
        "url": "overlay.html",
        "additionalBrowserArgs": "--use-fake-ui-for-media-stream --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
